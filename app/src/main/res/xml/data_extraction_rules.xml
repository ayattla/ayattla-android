<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same rules for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="projects/" />
        <include domain="file" path="templates.json" />
        <exclude domain="file" path="media/" />
        <exclude domain="file" path="exports/" />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="projects/" />
        <include domain="file" path="templates.json" />
        <include domain="file" path="media/" />
        <exclude domain="file" path="exports/" />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
